  "resolutions": [
    {
      "sourceKey": "47e7948e1b27cd6aaa208f975ca3689032ece2acff42588d2bfe49af5c6539f5",
      "meetingDateJalali": "1405.04.06",
      "number": "2",
      "text": "برگزاری شایسته آزمون‌های نهایی و پایانی در مورد مقرر \nبازرسی و سرکشی به حوزه‌های آزمون‌ها به صورت روزانه و رفع مشکلات نرم‌افزاری و سخت‌افزاری اوضاع توسط مدیران‌کل، رؤسای ادارات سنجش و ارزیابی عملکرد استان‌ها\nتشکیل ستاد آزمون ‌استان ها در اسرع وقت توسط مدیران‌کل و اتخاذ تدابیر لازم برای رفع کامل ایرادات و نقایص موجود\nبرگزاری مانور امتحانات نهایی در روز یکشنبه 7 تیرماه و ارائه گزارش آن توسط مرکز سنجش و ارزشیابی \nارایه گزارش آخرین وضعیت محل‌های برگزاری آزمون توسط مرکز ارزشیابی در شورای معاونان",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "e86d617224e3e4189f192cbe7501276d4443b870616669d266b2fabae1d2bc3b",
      "meetingDateJalali": "1405.04.06",
      "number": "4",
      "text": "اجرای دقیق بخشنامه تعیین تکلیف نیروهای حق‌التدریس در استان با مسئولیت مدیرکل استان \nنشست مدیران‌کل با مدیران منابع انسانی استان در خصوص اجرای مطلوب این بخشنامه \nصدور دو ابلاغ برای همکاران (حقوق ،کار) در این طرح\nتکمیل فرآیند نقل و انتقالات با آرامش و با  اولویت بر خالی نبودن کلاس درس و مازاد نشدن معلم و در نهایت، مساعدت با همکاران",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "ba6f12ea188a1d8e370068176c82c004dc234a06aba0e0fae73241c6d2e96499",
      "meetingDateJalali": "1405.04.06",
      "number": "6",
      "text": "رصد روزانه تمامی شاخص‌های وزارتخانه توسط مدیران کل در مناطق و شهرستان‌های سراسر کشور (امتحانات، نقل و انتقالات، ساماندهی و سازماندهی نیروی انسانی، کتب درسی، کیفیت بخشی، اوقات فراغت و...)",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "ad19c8f9c866d83ea530efd12ca7f337a49159497b3d9ff3dc814bc0eb5c4f83",
      "meetingDateJalali": "1405.04.06",
      "number": "7",
      "text": "پیگیری‌ افزایش ضریب نفوذ کودکستان‌ها",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "8cabe4ea03d2f83992e903efd9e3705c20af00ebfc58e2fe72cd5aeb60a6fae6",
      "meetingDateJalali": "1405.04.06",
      "number": "9",
      "text": "برگزاری سی و نهمین  اجلاس رؤسای آموزش و پرورش کشور، در روزهای ۲۵ لغایت ۲۷ مرداد ماه به صورت ترکیبی (حضوری/ مجازی) در سراسر استان‌های کشور",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "9dbc9ba8358705aafd8fc489b3000ea47ad2f82422de1a1ed5399382005b4a98",
      "meetingDateJalali": "1405.04.20",
      "number": "1",
      "text": "استمرار برنامه‌های نظام تعلیم و تربیت بر اساس منویات و منظومه فکری امام شهید انقلاب اسلامی(قدس سره)",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل",
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "18b6b1e2d6b4eaca3eeb474f30bbd02273109a5f757f1d2e164f5b14d134bd04",
      "meetingDateJalali": "1405.04.20",
      "number": "4",
      "text": "استمرار فعالیت‌های اتاق وضعیت ساماندهی نیروی انسانی و پروژه مهر، ثبت نام، پوشش تحصیلی، توزیع کتب درسی، نقل و انتقالات، پایگاه‌های تابستانی و اوقات فراغت، برگزاری مسابقات ورزشی، طرح حامی، جبران خدمات آموزشی، دبیرخانه  سی و نهمین اجلاس رؤسای آموزش و پرورش کشور و... با هدف آغاز بدون مشکل سال تحصیلی جدید",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل",
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "c9d4c1d3c40022d94a095ef751382f0bcdd76195693d4c4bfd27d7f56cf592ca",
      "meetingDateJalali": "1405.04.20",
      "number": "7",
      "text": "پایان مردادماه، آخرین فرصت انجام ماموریت‌ها و انتصاب‌ها در پست‌های اداری، نظارت مستقیم مدیران‌کل بر پرداخت حقوق نیروهای حق‌التدریس در تیرماه، اطلاع رسانی به معلمان در خصوص فعال شدن سامانه اعتراض به رتبه‌بندی، نظارت مدیران‌کل و رؤسای مناطق بر منابع مالی مدارس در فصل تابستان",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "157c0b749d3c3746f1a3dd81716bd1c2dd663452c5d3b83bcc8a1d3dab89dcf1",
      "meetingDateJalali": "1405.04.27",
      "number": "2",
      "text": "راهبردهای وزارت آموزش و پرورش در برگزاری مطلوب آزمون‌های پایانی؛ انسجام و همدلی در تصمیم‌گیری‌، اجرا و تبیین امتحانات پایانی با عنایت به محدودیت زمان تا شروع سال تحصیلی جدید و نیز وجود شرایط جنگی در کشور، تصحیح با کیفیت و توأم با سرعت اوراق آزمون‌ها، یک‌صدایی از ستاد تا صف",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل",
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "4e0963ea9686dd3a84e70c7db6e0a38d69d7f71fc0bdb03386f657b975c26cc8",
      "meetingDateJalali": "1405.04.27",
      "number": "3",
      "text": "تبیین دقیق توصیه‌های مقام عالی وزارت و دبیرکل محترم شورای‌عالی آموزش و پرورش به استناد مصوبه 1073 آن شورا به مدیران، همکاران، اولیاء و دانش‌آموزان با استفاده از ظرفیت‌های رسانه‌ای و انتشار حداکثری کلیپ‌های تولیدی در این خصوص",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل",
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "0a64e6f7026f5013a8f8576e0b9550c6b267832b5649c41196f25f2adb77ef80",
      "meetingDateJalali": "1405.05.03",
      "number": "3",
      "text": "تداوم حفاظت، حراست و رعایت تمامی تدابیر امنیتی، فیزیکی و... در حوزه‌های امتحانی ، برخورد قاطع با متخلفان در جلسه ، ارسال گزارش مکتوب خاطیان به سازمان سنجش",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "2d37ca2ad8a58824df540ed397614c87252f0760a83cd22bb3efb3a7652e6d3a",
      "meetingDateJalali": "1405.05.03",
      "number": "5",
      "text": "پرداخت حقوق تابستانی به معلمان حق‌التدریس منوط به بکارگیری آن‌ها در فضاهای آموزشی یا شبه‌اداری نظیر کانون‌های فرهنگی، پژوهش‌سراها، مراکز مشاوره و... و ارائه گزارش عملکرد به مقام عالی وزارت",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "ca419db0c7d704df5072051dc68d2000d03e73e184340cd22d7c756ce92a5963",
      "meetingDateJalali": "1405.05.10",
      "number": "6",
      "text": "پیگیری اتمام فرآیند تصحیح و نمره‌گذاری امتحانات",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "83689af8922dd35f1fc431125e6e9d62509ef5c5e40c61e9be65be67b73d054e",
      "meetingDateJalali": "1405.05.17",
      "number": "7",
      "text": "برخورد قاطع با متخلفان حوزه‌های برگزاری آزمون‌ها",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "24dd9aa232eb846644e814fd45a4d38b6789c4df978f36aa5485addb467c2b1e",
      "meetingDateJalali": "1405.05.17",
      "number": "8",
      "text": "تسهیل فعالیت و مساعدت کامل با اتحادیه انجمن‌های اسلامی دانش‌آموزی از فضای مازاد، نیروی انسانی و...",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "af1719fc97b7ba88da8fe735282515fd3110f3216caf27c222cfe8bb0fe66bad",
      "meetingDateJalali": "1405.05.31",
      "number": "4",
      "text": "برگزاری گردهمایی مدیران مدارس در مناطق، نواحی، شهرستان‌های سراسر کشور با هدف تبیین پیام‌ها و محتواهای اجلاس سی و نهم، بهره‌مندی از ظرفیت اعضای شورای معاونان استان‌ در این نشست‌ها ، پیگیری جدی مدیران‌کل برای تحویل مدارسِ در اختیار دستگاه‌های استانی و آماده‌سازی آن مدارس برای آغاز سال تحصیلی، تسریع همراه با دقت و کیفیت در تصحیح اوراق امتحانی پایه یازدهم و دوازدهم",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "d45b8dd0cd0576c9f4092787a7f1529c002592c19824b26199cabcc4c81cb712",
      "meetingDateJalali": "1405.05.31",
      "number": "4",
      "text": "حضور مؤثر مدیران‌کل در شورای اداری استان به‌مناسبت هفته دولت که با حضور یکی از اعضای هیئت دولت برگزار می‌گردد؛ با رویکرد تقدیر از حمایت‌های گسترده رییس جمهور محترم از نظام تعلیم و تربیت و جلب پشتیبانی نماینده دولت از آموزش و پرورش استان",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "a191b8bb8ce4e16b009839e5dd1b1725dce345ade187a7e42857f3c3b562e9da",
      "meetingDateJalali": "1405.06.07",
      "number": "2",
      "text": "رفع سه مشکل اصلی وزارت متبوع در خصوص جشنواره شهید رجایی: کمبود اطلاعات متولی آن از شاخص‌های ارزشیابی، ضعف در مستندسازی از فعالیت‌ها، ضعف در بارگذاری  /تعیین متولی جشنواره شهید رجایی با صدور ابلاغ در معاونت‌ها/ سازمان‌ها/ مراکز حوزه‌ ستادی و ادارات‌کل استان‌ها",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل",
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "b2bf88e2969fb46811a3a1b28dea706a599add3bae7764ecba9563bef534c653",
      "meetingDateJalali": "1405.06.07",
      "number": "5",
      "text": "سه رویکرد اصلی آغاز سال تحصیلی:شهادت قائد شهید انقلاب اسلامی(قدس ا... نفسه زکیه)، شهدای مدرسه شجره طیبه میناب، جنگ رمضان/ اهتمام معین‌های استانی و تمرکز ادارات‌کل استان‌ها در طراحی و اجرای برنامه‌ها و تولید محتوای فاخر با محوریت معاونت پرورشی بر اساس سه محور فوق",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل",
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "47a5f59f8890ef563485848cd10ce3c2ba5dd0bf51d392430744d64abd0cddcc",
      "meetingDateJalali": "1405.06.07",
      "number": "7",
      "text": "تشکیل کارگروه ویژه به منظور تدوین سناریوهای متعدد و متفاوت برای واکنش در شرایط بحران‌ متشکل از معاونان آموزشی و پرورشی و آقایان امانی، بحری‌زاده، فرهادی، محبی و هاشمی/ آمادگی برای مواجهه با فتنه های متعدد و بحران‌ها و تدوین سناریوهای مختلف\nتمرکز کامل و رصد دقیق ۵۰۰۰ مدرسه هدف\nبرگزاری مستمر جلسات کارگروه مدیریت بحران یا ارتقاء مدیریت آموزشگاه با مسئولیت مدیرکل استان و پیگیری توسط مدیر حراست استان‌ها\nبرگزاری جلسه مجازی مقام عالی وزارت با مدیران مدارس هدف در بستر امن\nتوجیه مدیران مدارس هدف، اولیا و تشکل‌های دانش آموزان آن توسط حراست",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل",
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "5c9b1131a40dc77c60503adf8c9892b6e1934e4615d47587ad9dc01ebec38304",
      "meetingDateJalali": "1405.06.07",
      "number": "8",
      "text": "برنامه‌ریزی و تعیین تکلیف دقیق مراسم نواختن زنگ مهر در هفته جاری با دعوت گسترده و باشکوه از چهره‌های شاخص ملّی و  استانی و بهره‌برداری از ظرفیت زنگ مهر برای حفظ جایگاه تعلیم و تربیت در مسائل کلان کشور",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل",
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "87cde560b33230c02fbc47c22d17f27edbb658c60da6e18fe99f5eee6dee2471",
      "meetingDateJalali": "1405.06.07",
      "number": "9",
      "text": "اجرای زنگ نماز و محفل انس با قرآن پیش از نماز ظهر در روز اول مهر در تمامی مدارس کشور و تدوین ساختار محفل انس با قرآن توسط معاونت پرورشی و کمیسیون عمومی آموزش قرآن",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل",
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "e3c7649336d2955eb17625e541a2a88936b2beaa071dc5dd61091ded7950cf3e",
      "meetingDateJalali": "1405.06.07",
      "number": "10",
      "text": "فضا آرایی کامل تمامی مدارس استان متناسب با رویکرد ایثار و شهادت با مسئولیت رییس اداره شاهد استان",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "744f9d4133d6dfc09bb3db12ff1cd05241f480c605dded5b23fa144d3f644acf",
      "meetingDateJalali": "1405.06.07",
      "number": "11",
      "text": "برنامه‌ریزی جهت پشتیبانی فرهنگی تربیتی «هر مدرسه از یکی از میادین اجتماعات مردمی» به صورت اختیاری و داوطلبانه",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "7e64bb5a36b2079c46ec47e75c36a98a036c464ddb9c12c15b2ef27642365a78",
      "meetingDateJalali": "1405.06.07",
      "number": "12",
      "text": "توجه جدی بر موضوع حجاب و عفاف و استفاده از ظرفیت معلمان و دانش‌آموزان در ترویج زیست عفیفانه",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "897f4888fb8a2dbb5417620140c0f51cd9d0be77783df5182dcb8578b818c9b9",
      "meetingDateJalali": "1405.06.07",
      "number": "13",
      "text": "اهتمام جدی بر اجرای پرسش مهر ریاست جمهوری",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "ba2788e72e0b833b75ad9ca7171a7bd3509dd7e534b272a0f77628716d3331ab",
      "meetingDateJalali": "1405.06.07",
      "number": "14",
      "text": "تداوم پیگیری و اهتمام در افتتاح باشکوه 2500 پروژه‌‌ی نهضت عدالت آموزشی سراسر کشور",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "8c64c23b56f49bc29fbb5338b431503420c89ec07f05ad152407e07c8b8a3671",
      "meetingDateJalali": "1405.06.07",
      "number": "19",
      "text": "برگزاری مستمر جلسات پروژه مهر و اتاق وضعیت ۲ جلسه در هفته؛رصد داشبورد مدیریتی توسط معین‌های استانی و ارائه گزارش از وضعیت استان به دبیرخانه معین‌های استانی",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "83fad7f34d65410470bdfea6155e680dfa2bb0c7132ef54e0dee2e24a1addcef",
      "meetingDateJalali": "1405.06.07",
      "number": "20",
      "text": "تدوین نقشه راه جامع و منسجم رسانه‎‌ای در خصوص بازگشایی مدارس/لزوم هوشیاری و سرعت‌عمل در واکنش‌های رسانه‌ای توسط مرکز اطلاع‌رسانی/ برگزاری نشست‌های خبری و حضور فعال شورای معاونان و مدیران‌کل استان در رسانه ملی",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل",
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "210efe20b3b8ac865f9461117bb271a1298b6b8c0596b1867e9d4b3bfad727a0",
      "meetingDateJalali": "1405.06.14",
      "number": "11",
      "text": "تدوین چارچوب مانور بازگشایی مدارس و مکلّف نمودن مدیران‌کل به انجام آن/ اطلاع‌رسانی به مدیران‌کل از طریق پیام/ ارتباط معین استان‌ها با مدیران‌کل و تأکید بر نظارت و کنترل فرآیند مانور",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "9b61380ce2c6d3126ee7c82d7b2c25b1cb42a1884b5f74848665d914e6493719",
      "meetingDateJalali": "1405.06.21",
      "number": "1",
      "text": "برگزاری گردهمایی مشترک اعضای شورای معاونان و مدیران‌کل استان‌های سراسر کشور» با موضوع پروژه مهر و بازگشایی مدارس از روز چهارشنبه 25/6/1405 لغایت پنج‌شنبه 26/6/1405",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل",
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "d670c3cba89da588e48699c073367d65bd51aab358e29f77ccdddd7dd7593b40",
      "meetingDateJalali": "1405.06.21",
      "number": "3",
      "text": "تسریع در تصحیح اوراق امتحانات/ بررسی و ارزیابی موضوع میزان تصحیح اوراق توسط معاونان آموزش متوسطه وزارت و ادارات‌کل استان‌ها/ تقدیر از ادارات‌کل پیشرو و تذکر به استان‌های دارای تأخیر در تصحیح",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "cdae561939da728e58ccdfe768f9f2a923440fd97e98510ac4285142f2d471fc",
      "meetingDateJalali": "1405.06.21",
      "number": "6",
      "text": "در اختیار گذاشتن تمامی امکانات اداره‌کل (فضا، تجهیزات، نیروی انسانی و...) به منظور اجرای شایسته گزینش داوطلبان دانشگاه فرهنگیان/ تسریع در فرآیند انتصاب گزینش‌گران توسط مرکز حراست و امور اداری/ برگزاری جلسه هماهنگی و برنامه‌ریزی اجرای مصاحبه و ارزیابی شایستگی‌های معلمی با مسئولیت مدیرکل استان و حضور مسئولان هسته‌های گزینش و دانشگاه فرهنگیان",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "3b4c2c829ef32e8d55dd18f86eeb007deac4aaf7ed19fd7a70e22c45ba904466",
      "meetingDateJalali": "1405.06.25-26",
      "number": "1",
      "text": "رواج زیست عفیفانه و حجاب و عفاف؛/مراقبت جدی از حفظ فضای معنوی و عفیفانه مدرسه؛/پیگیری دستورالعمل زیست عفیفانه توسط مدیران حراست استان‌ها؛/تشکیل کارگروه زیست عفیفانه ستاد و استان و پیگیری توأم با ظرافت موضوع.",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل",
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "f282b4b0505b0912f1a290b1cb0f994fe8dd6d4a40c0cccde3a9bd55a00083e5",
      "meetingDateJalali": "1405.06.25-26",
      "number": "2",
      "text": "عامل و مروج اقامه نماز بودن؛استفاده از همه ظرفیت‌ها در اقامه نماز و قرآن؛توصیه به همکاران برای حضور در نماز جماعت؛تقویت کمیسیون قرآن در مناطق.",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل",
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "d6e80c4223710e4e4db17541f62da4e3ab3cc0a36260e07fa2d185316585824b",
      "meetingDateJalali": "1405.06.25-26",
      "number": "3",
      "text": "گفتمان رایج آموزش و پرورش؛ اجرای سند تحول بنیادین/ نقشه راه/ کیفیت آموزشی، هویت ملّی و اسلامی، عدالت آموزشی/ پیگیری برنامه های تحولی  (تحول در برنامه درسی با اولویت 200 مدرسه / مدرسه الگوی تراز سند تحول در منابع انسانی / تحول در حوزه پرورشی /تحول در ساختار نظام آموزشی)/تحول در حکمرانی آموزش و پرورش.",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل",
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "a3eb402fe461d95724d680af8562ef5e9b4630ad2df5ab3e6220adaae3dc7726",
      "meetingDateJalali": "1405.06.25-26",
      "number": "4",
      "text": "تقویت فعالیت‌های پرورشی و مشخص شدن نسبت نظام تعلیم و تربیت با میدان",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "0019c902fd95c95339d5bae737fb8e820391fade062dbe82654c1e8ce4c2da86",
      "meetingDateJalali": "1405.06.25-26",
      "number": "5",
      "text": "اهتمام بر اجرای شایسته طرح‌ها و به سرانجام رساندن آنها؛تأکید مستمر بر آغاز با نشاط و  باشکوه سال تحصیلی در سراسر کشور؛آموزش زیست جنگی؛مقاومت در مقابل تعطیلی‌ مدارس؛واگذاری موضوع تعطیلی مدارس به شورای تأمین استان؛در اختیار گرفتن تمامی فضاهای آموزشی که در اختیار دیگر دستگاه‌ها بوده است.",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل",
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "7d3d300fc4144b0b59780966c58b8e3946e6d3ef67c8ef77fbe09c6542f55aaa",
      "meetingDateJalali": "1405.06.25-26",
      "number": "6",
      "text": "بهره‌برداری کامل و شایسته از فرصت بازگشایی مدارس به‌عنوان موقعیت ارزشمند تبیین و جهاد نظام تعلیم و تربیت؛ تدوین نقشه راه پیوست رسانه‌ای جامع توسط مرکز روابط عمومی؛ تبیین عملکرد دولت؛ تهیه کلیپ اختصاصی معاونت‌ها در استان از دستاوردهای دولت",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "f5f90083e8b7f361d84fca843411568795a1578ad0ddf1df9a6c27fc53a5975f",
      "meetingDateJalali": "1405.06.25-26",
      "number": "7",
      "text": "فرهنگ سازی و گفتمان سازی در صرفه جویی؛ تدوین دستورالعمل صرفه‌جویی در آب، برق و گاز ؛ اجرای کامل طرح یک روز بدون خودرو",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل",
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "938306c931d9468009f9e2e7d47c4436d90fe6aefc1dfa56e80de169a13d9691",
      "meetingDateJalali": "1405.06.25-26",
      "number": "8",
      "text": "فعال سازی شورای آموزش و پرورش؛ هدایت دستورکارهای شورای آموزش و پرورش از مسائل سخت‌افزاری به موضوعات تربیتی، کیفیت بخشی، پرورشی و... همراه با گفتمان سازی",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "ece162e274362a986ecde5b782e6588c9b56c889688a0812f500572cf7b8f202",
      "meetingDateJalali": "1405.06.25-26",
      "number": "9",
      "text": "تعامل سازنده با نمایندگان محترم مجلس شورای اسلامی و دعوت به حضور در مراسم‌ها و برنامه‌های آموزش و پرورش استان",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل",
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "9e7ef1f31691fc178b9947b7015df219bb524c93d26ac5fed598e821076be48f",
      "meetingDateJalali": "1405.06.25-26",
      "number": "11",
      "text": "توجه ویژه به بازنشستگان محترم/ احصاء نظام مسائل و پیگیری جدی/ ارتباط مستمر با بازنشستگان /فعال سازی مشاور امور بازنشستگان در استان",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "bd35ebbd6a4d1986b9cca13a197eb1edc6489777e25050042569dd404c0f8c9f",
      "meetingDateJalali": "1405.06.25-26",
      "number": "12",
      "text": "تقویت و افزایش سهم فنی حرفه‌ای از توسعه متوازن؛ اهتمام بر اجرای کامل طرح «هر دانش آموز یک مهارت»",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل",
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "2d55a48b6694db624e817a72df5eb76f40dcea9103c10d5f06c3a64e2c33b372",
      "meetingDateJalali": "1405.06.25-26",
      "number": "13",
      "text": "تاکید بر جشنواره هویت در آموزش ابتدایی و مهم دانستن آن/ تلفیق برنامه‌های ورزشی با هویت ملّی و دینی",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "5954f946f70c52761f0cb22a203bf1076e4eeda0f9616f76494dee38bae61835",
      "meetingDateJalali": "1405.06.25-26",
      "number": "14",
      "text": "عضویت مدیرکل نوسازی، مدیرکل کانون پرورش فکری کودکان و نوجوانان و رئیس دانشگاه فرهنگیان در شورای معاونان اداره‌کل آموزش و پرورش استان",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل",
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "bea88c41a0fbb11ef89f3709986f47d18c9a60767b354b4daa008decd4ec411e",
      "meetingDateJalali": "1405.06.25-26",
      "number": "15",
      "text": "پیگیری نهضت توسعه عدالت در قرارگاه عدالت آموزشی",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل",
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "9f6ab2dc90a9d1e3339989c93d7bac22a7a504de9c1b9ff14eb4744f6dbd5bdd",
      "meetingDateJalali": "1405.06.25-26",
      "number": "16",
      "text": "مراقبت از سلامت اداری اخلاقی و سیاسی همکاران/ توجه کامل به الگو بودن رفتار، گفتار و سبک زندگی مقام مافوق هر بخش برای سایر همکاران",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل",
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "780f2a1c9bdb3093d67e433de89841259deb7ca14aabd9cbc923014ff51b2ef7",
      "meetingDateJalali": "1405.06.25-26",
      "number": "17",
      "text": "حفظ ارتباط با همه تشکل‌های فرهنگیان/ پرهیز جدی ازسوء استفاده از امکانات بیت المال برای برنامه‌های سیاسی و حزبی",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل",
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "31373c69a37ff007870fce216141c08d96a688a8c867afef116a875f92d1ba96",
      "meetingDateJalali": "1405.06.25-26",
      "number": "19",
      "text": "تلاش مضاعف و پیگیری موضوع راهبردی «پیشگیری از آسیب‌های اجتماعی و اجرای طرح نماد»",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل",
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "82b140b49f1a5b119dff85ed3357ab89d03f91f34a320f5e05f3f47cd3031cb0",
      "meetingDateJalali": "1405.06.25-26",
      "number": "20",
      "text": "توجه جدی به موضوع بازماندگان از تحصیل و اطلاع رسانی به موقع همراه با تسلط بر آمار",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل",
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "f6f0fcabdb20df99425c4b6df37766ed51a0dc27fe2c52b787806ed55c584ca8",
      "meetingDateJalali": "1405.06.25-26",
      "number": "21",
      "text": "توجه ویژه به اجتماعات مردمی در میدان و پشتیبانی فرهنگی، محتوایی و... از آن",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل",
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "52d3ab7e17b2fde93b984983e63bf83683d1a1702a2dff5e0d5f944061db8808",
      "meetingDateJalali": "1405.06.25-26",
      "number": "22",
      "text": "همکاری با نهضت سوادآموزی",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "863198b1e32b05a8397f1916070f87a1863d6c107437a3daaaa87cca83fff1e3",
      "meetingDateJalali": "1405.06.25-26",
      "number": "23",
      "text": "توجه ویژه به دانش آموزان استثنایی/متناسب سازی مدارس و ممانعت از بازماندگی از تحصیل این دانش‌آموزان",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "2de5858ce2dfa25b841adc6fca93c9193d2366be5973b86f36bf5ed36a805be4",
      "meetingDateJalali": "1405.06.25-26",
      "number": "24",
      "text": "استفاده حداکثری از ظرفیت حوزه‌های علمیه و اختصاص یک پست و نیرو به دفتر همکاری‌ها/ فعال سازی شورای هماهنگی حوزه علمیه و آموزش و پرورش در استان",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "25cceb95255e61fc93f70885ab72d742f24fe6e4c622208c3404f00109bdddf6",
      "meetingDateJalali": "1405.06.25-26",
      "number": "25",
      "text": "توجه به مدارس سمپاد و باشگاه دانش پژوهان جوان؛ دقت در نحوه به کارگیری نیروهای غیر رسمی و به حداقل رساندن آن؛ دقت در انتصاب مدیران توانمند و قوی برای مدارس سمپاد",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "86d6a65a697a105395b45dd59a420932967baf0e3e2533df6f926c8896cffcad",
      "meetingDateJalali": "1405.06.25-26",
      "number": "26",
      "text": "تقویت تعامل همکاری با کانون پرورش پیگیری کودکان نوجوانان به عنوان قوی‌ترین پایگاه کودک و نوجوان کشور؛ تشکیل جلسات همکاری و تعامل مشترک کانون با معاونت‌های‌ آموزش ابتدایی و متوسطه و معاونت‌ پرورشی به منظور بهره‌مندی از خدمات کانون پرورش فکری",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "4ad590812acf268481ae28674d984d5ff2fcf20c6a4166a8b0392d6839821bba",
      "meetingDateJalali": "1405.06.25-26",
      "number": "27",
      "text": "توجه به خانواده شهدای ایثارگران مدارس شاهد؛ تعبیه یک یادمان ثابت از شهدا در تمامی مدارس؛ استفاده از فرصت هفته دفاع مقدس به منظور ترویج فرهنگ ایثار و شهادت؛ احصاء آمار شهدای فرهنگی جنگ‌های تحمیلی دوم و سوم و پیگیری مسائل معیشتی، حقوقی، درمانی و... توسط خانم مظفر با همکاری خانم پناهی روا و گزارش به مقام عالی وزارت",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل",
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "d41d41b00b1e7c9e2a3f779bb9ab9a6c4b7e62687e66c3454adb664f6715cb56",
      "meetingDateJalali": "1405.06.25-26",
      "number": "28",
      "text": "گفتمان سازی و مشارکت فعال در  اجرایی‌سازی راهبرد کاهش تنوع مدارس",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل",
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "09f436a2f9b9c3f33fb5950c63dc73a13ae4a1c747706b225800fc4e63f9cfd9",
      "meetingDateJalali": "1405.06.25-26",
      "number": "29",
      "text": "راهبری و سیاست‌گذاری آموزش تمامی مدارس کشور ذیل معاونت‌های آموزش ابتدایی و متوسطه وزارت متبوع",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل",
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "bb4081d22752c432ac1c64a1ab92c65399e233ba4f6943536bbc3f56c143b979",
      "meetingDateJalali": "1405.06.25-26",
      "number": "30",
      "text": "تعبیه طرح فاخر پرچم و نقشه ایران اسلامی در مدارس سراسر کشور با طراحی برجسته و ناظر بر هویت منطقه‌ای و بومی هر استان ؛ طراحی نقشه و پرچم با هنر کاشی‌کاری در مدارس نوساز",
      "notes": "",
      "status": "before",
      "groups": [
        "مدیران کل"
      ]
    },
    {
      "sourceKey": "acfc95883130ef28b75ae42260d8cc4b6cea2a7bd0b6b781038dbcaca474a6fc",
      "meetingDateJalali": "1405.05.10",
      "number": "3",
      "text": "پیگیری جدی برای تکمیل فرآیند ثبت‌نام در تمامی مقاطع",
      "notes": "",
      "status": "before",
      "groups": [
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "c8e5dcc4970bd09219f72c83b416d939db82dcbd400f87dcf53d495a2556b220",
      "meetingDateJalali": "1405.05.10",
      "number": "10",
      "text": "تعامل خوب و قوی با نمایندگان مجلس شورای اسلامی و بهره‌مندی از ظرفیت‌های ایشان در راستای مأموریت‌ها ، هماهنگی ارتباط‌ها و اقدامات اعضای شورای معاونان درخصوص نمایندگان مجلس شورای اسلامی با معاونت امور مجلس و دفتر وزارتی",
      "notes": "",
      "status": "before",
      "groups": [
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "abcb95798ba091ce9229d3cf01db4fc1cb1fe5ffdf224906a0ef901642cc9d28",
      "meetingDateJalali": "1405.05.10",
      "number": "12",
      "text": "اولویت محتوایی اجلاس سی و نهم:- تلاش برای تاب‌آوری و زیست جنگی ، - بیان سیاست‌های کلان، - نزدیک شدن صف و ستاد",
      "notes": "",
      "status": "before",
      "groups": [
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "eb3f0092ddb94d4c973ee75d56e5c71955af9423c906ef6508be3e5335d251dd",
      "meetingDateJalali": "1405.06.07",
      "number": "4",
      "text": "تبدیل برگزاری تمامی گردهمایی‌های حضوری به مجازی در شهریور ماه و موکول نمودن گردهمایی‌های حضوری به بعد از مهرماه",
      "notes": "",
      "status": "before",
      "groups": [
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "36ce27a8b3e6b6955d71af4d4c74d8b31d4b798198df1084304038b891aff613",
      "meetingDateJalali": "1405.06.14",
      "number": "3",
      "text": "بررسی دقیق و اصلاح اطلاعات گزارش اولیه و غیررسمی عملکرد سال 1404 وزارت متبوع در راستای تحقق تکالیف قانون برنامه هفتم پیشرفت",
      "notes": "",
      "status": "before",
      "groups": [
        "شورای معاونان"
      ]
    },
    {
      "sourceKey": "7aedd556f1232a1b823975fb57379539d6043a38dd29c6589921cef926609c62",
      "meetingDateJalali": "1405.06.14",
      "number": "8",
      "text": "پیگیری جدی مصوبات سیزدهمین جلسه مشترک شورای معاونان و مدیران‌کل استان‌ها (2901/م/140/ص به تاریخ 10/6/1405) و تأکید بر موارد زیر: استمرار اتاق وضعیت و پروژه مهر/حاکمیت رویکرد رهبر شهید، جنگ رمضان، شهدای مدرسه میناب در برنامه‌های بازگشایی مدارس/تأمین نیروی انسانی/ زنگ نماز و انس با قرآن /تعیین تکلیف سناریوی بازگشایی مدارس/پرچم گردانی /فضا آرایی مدرسه با رویکرد جهاد، مقاومت و شهادت/پشتیبانی از میادین اجتماعات مردمی/زیست عفیفانه و حجاب اسلامی/افتتاح 2300 پروژه /اجرای الگوی مدرسه تراز /نظارت بر کودکستان‌ها، مراکز پیش‌دبستانی و مدارس غیردولتی/ مدرسه تلویزیونی ایران/ تدوین نقشه راه اطلاع‌رسانی و رسانه/ کارگروه بازنشستگان/هیأت‌های اندیشه‌ورز",
      "notes": "",
      "status": "before",
      "groups": [
        "شورای معاونان"
      ]
    }
  ]
}
